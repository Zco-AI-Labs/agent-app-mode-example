            {
              "type": "button",
              "props": {
                "label": "Rebalance Grid ⚖️",
                "actionUrl": "app://rebalance_grid?shields_power=75&warp_power=75&sensors_power=75&aux_power=75&grid_status=OPTIMAL&announcement=Power%20grid%20rebalanced%20across%20all%20subsystems.",
                "styling": {
                  "colorTheme": "amber"
                }
              }
