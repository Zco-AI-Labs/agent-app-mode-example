            {
              "type": "button",
              "props": {
                "label": "Sensor Sweep 📡",
                "actionUrl": "app://scan_sector?sensors_power=100&shields_power=70&warp_power=50&aux_power=80&grid_status=SECTOR%20SWEEP&announcement=Tactical%20sensors%20conducting%20full-frequency%20sector%20sweep.",
                "styling": {
                  "colorTheme": "blue"
                }
              }
