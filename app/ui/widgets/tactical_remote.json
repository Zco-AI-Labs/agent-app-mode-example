                "actionUrl": "app://boost_shields?shields_power=100&warp_power=60&sensors_power=50&aux_power=90&grid_status=COMBAT%20READY&announcement=Defensive%20shields%20boosted%20to%20100%25%20maximum%20output.",
                "styling": {
                  "colorTheme": "emerald"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Engage Warp 🚀",
                "actionUrl": "app://engage_warp?warp_power=100&shields_power=60&sensors_power=50&aux_power=90&grid_status=HIGH%20WARP&announcement=Warp%20engines%20engaged%20at%20warp%20factor%209.5.",
                "styling": {
                  "colorTheme": "blue"
                }
              }
